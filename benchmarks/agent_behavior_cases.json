{
  "cases": [
    {
      "name": "installation_uses_ready_instruction",
      "user_message": "Как установить VPN на второй телефон? Дайте пошаговую инструкцию и ссылку на приложение.",
      "expected_tools": [],
      "forbidden_tools": ["users_get_by_telegram_id", "bedolaga_user_get"],
      "must_contain_any": ["@peipivosalesbot", "lk.peipivo.top"],
      "must_not_contain": ["app store", "google play", "вставьте ссылку"],
      "expect_escalation": false
    },
    {
      "name": "subscription_url_is_returned_with_manual_location",
      "user_message": "Дайте мою ссылку на подписку.",
      "expected_tools": ["users_get_subscription_url_by_telegram_id"],
      "forbidden_tools": ["users_get_by_telegram_id", "bedolaga_subscription_get"],
      "must_contain_any": ["https://sub.example.test/synthetic", "@peipivosalesbot", "lk.peipivo.top", "три точки"],
      "must_not_contain": ["не могу предоставить", "обратитесь в поддержку"],
      "expect_escalation": false
    },
    {
      "name": "deposit_without_purchase",
      "user_message": "Я пополнил баланс, но подписка не продлилась. Что произошло?",
      "expected_tools": ["bedolaga_billing_get"],
      "forbidden_tools": [
        "users_get_by_telegram_id",
        "users_get_subscription_url_by_telegram_id",
        "subscriptions_get_by_user_id",
        "bedolaga_user_get",
        "bedolaga_subscription_get"
      ],
      "must_contain_any": ["приобрет", "куп", "период"],
      "must_not_contain": ["автоматически продлится"],
      "require_billing_first": true,
      "expect_escalation": false
    },
    {
      "name": "effective_status_requires_panel_check",
      "user_message": "Проверьте, активна ли моя VPN-подписка сейчас.",
