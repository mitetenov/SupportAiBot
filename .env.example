LLM_PROVIDER=openai
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SUPPORT_GROUP_CHAT_ID=-1001234567890
TELEGRAM_SUPPORT_ADMIN_USERNAME=admin_username
TELEGRAM_SUPPORT_ADMIN_TELEGRAM_IDS=123456789,987654321
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=your_gemini_api_key_here
# Доступные модели: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=sk-your_openai_api_key_here
# Доступные модели: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Если модель не поддерживает temperature (gpt-5.6-luna и т.п.), установите OPENAI_TEMPERATURE=1
# OPENAI_TEMPERATURE=1
EMBEDDING_PROVIDER=gemini
# Панель должна быть версии 3.3.x — MCP 3.x собран под её контракт API.
REMNAWAVE_BASE_URL=https://vpn.example.com
REMNAWAVE_API_TOKEN=your_remnawave_api_token_here
REMNAWAVE_MCP_URL=http://mcp-remnawave:3100
# Гейт БОТА: false — модели доступно удаление HWID-устройств; true — все
# write-операции скрыты. Не путать с REMNAWAVE_IS_SUPPORT ниже.
REMNAWAVE_MCP_READONLY=false
# Гейт MCP-СЕРВЕРА: режим support (16 пользовательских инструментов, креды
# вырезаны из ответов панели). Парсится fail-closed — полный доступ ко всем
# 179 инструментам открывает только точная строка "false". Боту он не нужен.
REMNAWAVE_IS_SUPPORT=true
# Таймаут запросов MCP к панели, мс. Пустое/0/мусор → 30000.
REMNAWAVE_TIMEOUT_MS=30000
# Все сервисы читают этот файл целиком через env_file, поэтому переменные
# берутся буквально — подстановка ${...} внутри env_file не работает.
# Образ pgvector ожидает POSTGRES_*, бот читает PGVECTOR_*: держите пары
# в синхроне (пользователь/пароль/база должны совпадать).
POSTGRES_USER=bot
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=vpnsupport
# Бот использует PGVECTOR_* (чтобы не конфликтовать с другими БД)
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_USER=bot
PGVECTOR_PASSWORD=your_secure_password
PGVECTOR_DB=vpnsupport
# Теги образов. MCP закреплён: его набор инструментов зависит от версии панели
# и от REMNAWAVE_IS_SUPPORT, поэтому :latest может молча убрать инструменты.
BOT_TAG=latest
MCP_TAG=v3.2.1
# Тег образа bedolaga-mcp: закрепите конкретную версию, не используйте latest.
BEDOLAGA_MCP_TAG=1.0.0
# MCP-инструменты Bedolaga для support: отдельный enable flag от тикетов ниже.
# false (безопасно) — бот работает только с инструментами Remnawave.
BEDOLAGA_MCP_ENABLED=false
# URL MCP-сервера Bedolaga по внутренней сети.
BEDOLAGA_MCP_URL=http://bedolaga-mcp:3100
# Тикеты Bedolaga. Пока false — бот работает только с Telegram-диалогами.
BEDOLAGA_ENABLED=false
# URL Web API Bedolaga, доступный с сервера support-бота. Сервисы могут быть
# на разных хостах; используйте HTTPS или адрес в приватной сети.
BEDOLAGA_API_URL=https://bedolaga.example.com
# Токен Web API: админка Bedolaga → API-токены, или POST /tokens.
BEDOLAGA_API_KEY=your_bedolaga_api_key_here
# Секрет вебхука: тот же самый указывается при создании вебхука в Bedolaga.
# Обязателен при BEDOLAGA_ENABLED=true — без него бот не стартует: эндпоинт
# принимал бы любые запросы без проверки подписи.
BEDOLAGA_WEBHOOK_SECRET=your_webhook_secret_here
# Путь, по которому бот слушает вебхуки на своём порту 8080.
BEDOLAGA_WEBHOOK_PATH=/bedolaga/webhook
# На каком интерфейсе docker-compose.bedolaga.yml публикует порт webhook.
# 127.0.0.1 — для reverse proxy на том же сервере. Для прямого доступа по
# приватной сети укажите приватный IP сервера support-бота.
BEDOLAGA_WEBHOOK_BIND=127.0.0.1
# Период сверочного опроса открытых тикетов, секунды. Вебхуки Bedolaga
# не ретраятся — этот опрос добирает потерянные события.
BEDOLAGA_POLL_INTERVAL_SECONDS=60
# Сколько тикетов бот обрабатывает одновременно. Один проход сверки может
# принести до 100 тикетов; без ограничения они разом выедают общий пул
# HTTP-соединений (его же используют LLM и эмбеддинги) и упираются в rate
# limit провайдера. Минимум 1.
BEDOLAGA_MAX_CONCURRENT_TICKETS=5
