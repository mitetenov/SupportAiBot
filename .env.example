LLM_PROVIDER=deepseek
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SUPPORT_GROUP_CHAT_ID=-1001234567890
TELEGRAM_SUPPORT_ADMIN_USERNAME=admin_username
TELEGRAM_SUPPORT_ADMIN_TELEGRAM_IDS=123456789,987654321
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=your_gemini_api_key_here
# Доступные модели: gemini-3.5-flash-light, gemini-3.5-flash, gemini-3.1-flash-lite, gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-light
OPENAI_API_KEY=sk-your_openai_api_key_here
# Доступные модели: gpt-5.6-luna, gpt-5.4-mini, gpt-5-turbo, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Если модель не поддерживает temperature (gpt-5.6-luna и т.п.), установите OPENAI_TEMPERATURE=1
# OPENAI_TEMPERATURE=1
EMBEDDING_PROVIDER=gemini
REMNAWAVE_BASE_URL=https://vpn.example.com
REMNAWAVE_API_TOKEN=your_remnawave_api_token_here
REMNAWAVE_READONLY=true
REMNAWAVE_MCP_URL=http://mcp-remnawave:3100
# pgvector-образ ожидает POSTGRES_* (для профиля local-db)
POSTGRES_USER=bot
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=vpnsupport
# Бот использует PGVECTOR_* (чтобы не конфликтовать с другими БД)
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_USER=${POSTGRES_USER:-bot}
PGVECTOR_PASSWORD=${POSTGRES_PASSWORD:-your_secure_password}
PGVECTOR_DB=${POSTGRES_DB:-vpnsupport}
BOT_TAG=latest
MCP_TAG=latest
