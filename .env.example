LLM_PROVIDER=deepseek
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SUPPORT_GROUP_CHAT_ID=-1001234567890
TELEGRAM_SUPPORT_ADMIN_USERNAME=admin_username
TELEGRAM_SUPPORT_ADMIN_TELEGRAM_IDS=123456789,987654321
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=your_gemini_api_key_here
# Доступные модели: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=sk-your_openai_api_key_here
# Доступные модели: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Если модель не поддерживает temperature (gpt-5.6-luna и т.п.), установите OPENAI_TEMPERATURE=1
# OPENAI_TEMPERATURE=1
EMBEDDING_PROVIDER=gemini
# Панель должна быть версии 3.3.x — MCP 3.x собран под её контракт API.
REMNAWAVE_BASE_URL=https://vpn.example.com
REMNAWAVE_API_TOKEN=your_remnawave_api_token_here
REMNAWAVE_MCP_URL=http://mcp-remnawave:3100
# Гейт БОТА: false — модели доступно удаление HWID-устройств; true — все
# write-операции скрыты. Не путать с REMNAWAVE_IS_SUPPORT ниже.
REMNAWAVE_MCP_READONLY=false
# Гейт MCP-СЕРВЕРА: режим support (16 пользовательских инструментов, креды
# вырезаны из ответов панели). Парсится fail-closed — полный доступ ко всем
# 179 инструментам открывает только точная строка "false". Боту он не нужен.
REMNAWAVE_IS_SUPPORT=true
# Таймаут запросов MCP к панели, мс. Пустое/0/мусор → 30000.
REMNAWAVE_TIMEOUT_MS=30000
# ВАЖНО: Docker Compose НЕ раскрывает переменные внутри env_file — значения
# берутся буквально. Поэтому POSTGRES_* и PGVECTOR_* дублируются явно;
# держите пары в синхроне (пользователь/пароль/база должны совпадать).
# pgvector-образ ожидает POSTGRES_*
POSTGRES_USER=bot
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=vpnsupport
# Бот использует PGVECTOR_* (чтобы не конфликтовать с другими БД)
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_USER=bot
PGVECTOR_PASSWORD=your_secure_password
PGVECTOR_DB=vpnsupport
BOT_TAG=latest
MCP_TAG=latest
