# Only runtime Go sources, embedded prompt and read-only FAQ assets enter builds.
# In particular, never send .env, Git state, docs or local caches.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!faq/
!faq/**

# Tests and their immutable reference payloads are not Go runtime inputs.
**/*_test.go
**/testdata/
**/testdata/**
faq/images/README.md

# Defense in depth for accidentally nested local credentials.
**/.env
**/.env.*

# Host-side validation/release tools are not runtime build inputs.
cmd/benchmarks/
cmd/check/
cmd/nextversion/
cmd/runtimeprobe/
cmd/verify/
internal/eval/
internal/release/
internal/verify/
internal/repopolicy/
