# Keep the build context small: everything not listed here is shipped to the
# daemon on every build, and changing any of it can invalidate the cache.

# Python build and cache artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
tests/

# VCS and CI
.git/
.gitignore
.github/
.worktrees/
.superpowers/

# IDE and OS
.idea/
*.iml
*.iws
*.ipr
.vscode/
.DS_Store

# Secrets and local state
.env
.env.example
data/
*.log
DataExport_*/

# Docs and orchestration — not needed to compile or run
README.md
CI-CD.md
docker-compose.yml
Dockerfile
.dockerignore
