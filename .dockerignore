# Keep the build context small: everything not listed here is shipped to the
# daemon on every build, and changing any of it can invalidate the cache.

# Build output — the image compiles from source, never from a local jar
target/
*.class
*.jar
*.war

# VCS and CI
.git/
.gitignore
.github/
.worktrees/

# IDE and OS
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.DS_Store

# Secrets and local state
.env
.env.example
data/
*.log
DataExport_*/

# Docs and orchestration — not needed to compile or run
README.md
CI-CD.md
docker-compose.yml
Dockerfile
.dockerignore
